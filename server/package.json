{
  "name": "fixora-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fixora REST API — Express + Firebase Admin SDK",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node tests/run.js",
    "seed": "node ../firebase/seed/seed.mjs",
    "seed:demo": "node ../firebase/seed/seed.mjs --demo",
    "create-admin": "node ../firebase/seed/createAdmin.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.0.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
