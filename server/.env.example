# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# ---------- Firebase Admin SDK ----------
# From Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines must be written as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=
# Alternative to the three variables above: path to a service-account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# ---------- AI chatbot (optional) ----------
# none | openai | anthropic | gemini  — FAQ answers work without any provider
AI_PROVIDER=none
AI_API_KEY=
# Optional model override (defaults: gpt-4o-mini / claude-haiku-4-5 / gemini-1.5-flash)
AI_MODEL=
AI_TIMEOUT_MS=15000

# ---------- Notifications (optional) ----------
# none | console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Fixora <no-reply@fixora.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# none | console
SMS_PROVIDER=none

# ---------- Payments (optional) ----------
# cash | stripe — cash is the default and needs no configuration
PAYMENT_PROVIDER=cash
STRIPE_SECRET_KEY=
PAYMENT_CURRENCY=gbp

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
