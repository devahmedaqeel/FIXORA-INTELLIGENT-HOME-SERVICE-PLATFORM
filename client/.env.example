# Firebase web app config — Firebase Console > Project settings > General > Your apps > Web app.
# These identify your project to the browser; they are not secrets, but keep real values out of Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# REST API base URL. "/api" uses the Vite dev proxy to http://localhost:5000.
# In production set the full URL of the deployed API, e.g. https://api.fixora.com/api
VITE_API_BASE_URL=/api
# Where the dev proxy forwards /api requests (development only)
VITE_DEV_API_TARGET=http://localhost:5000
